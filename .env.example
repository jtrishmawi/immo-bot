# Telegram (optional if WhatsApp is configured)
TELEGRAM_BOT_TOKEN=your-telegram_bot_token
TELEGRAM_CHAT_ID=your-telegram_chat_id

# WhatsApp via Baileys sidecar (optional if Telegram is configured)
WHATSAPP_PHONE="your-whatsapp_phone" # number to pair, no + — also used as recipient if WHATSAPP_TO is unset
# WHATSAPP_TO="your-# whatsapp_to" # optional — recipient with +, defaults to +WHATSAPP_PHONE

# Copy your search URLs directly from the Seloger browser address bar after searching.
# Add SEARCH_URL_3, SEARCH_URL_4, ... for additional searches or other sites.
SEARCH_URL_1=your-search_url_1
SEARCH_URL_2=your-search_url_2
